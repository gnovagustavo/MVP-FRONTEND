<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPG Campaign Manager - Multi-Sistema</title>

  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
    }
  </script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--scroll-track); }
    ::-webkit-scrollbar-thumb { background: var(--scroll-thumb); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--scroll-thumb-hover); }

    :root {
      --scroll-track: #0f172a;
      --scroll-thumb: #334155;
      --scroll-thumb-hover: #475569;
    }
    .light {
      --scroll-track: #f1f5f9;
      --scroll-thumb: #cbd5e1;
      --scroll-thumb-hover: #94a3b8;
    }

    /* ===== TEMA POR SISTEMA DE RPG ===== */
    :root { --accent: #4f46e5; }
    [data-sistema="dnd"]               { --accent: #c4291c; }  /* D&D 5e */
    [data-sistema="ordem_paranormal"]  { --accent: #7c3aed; }  /* Ordem Paranormal */
    [data-sistema="tormenta20"]        { --accent: #b91c1c; }  /* Tormenta20 */

    :root, [data-sistema] {
      --accent-hover: color-mix(in srgb, var(--accent) 82%, white);
      --accent-text:  color-mix(in srgb, var(--accent) 55%, white);
      --accent-light: color-mix(in srgb, var(--accent) 60%, white);
    }
    body .bg-indigo-600 { background-color: var(--accent); }
    body .hover\:bg-indigo-500:hover { background-color: var(--accent-hover); }
    body .bg-indigo-600\/20 { background-color: color-mix(in srgb, var(--accent) 20%, transparent); }
    body .bg-indigo-500\/10 { background-color: color-mix(in srgb, var(--accent) 12%, transparent); }
    body .text-indigo-400, body .text-indigo-300 { color: var(--accent-text); }
    body .border-indigo-500\/30 { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
    body .border-indigo-500, body .focus\:border-indigo-500:focus { border-color: var(--accent); }
    body .shadow-indigo-600\/20 { --tw-shadow-color: color-mix(in srgb, var(--accent) 25%, transparent); --tw-shadow: var(--tw-shadow-colored); }
    body ::selection { background-color: var(--accent); color: #fff; }
    .btn-campanha { border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); color: var(--accent-text); }
    .btn-campanha:hover { background: color-mix(in srgb, var(--accent) 15%, transparent); }
    .sistema-card { border: 1px solid #334155; border-radius: .75rem; padding: .6rem; text-align: center; transition: .2s; }
    input:checked + .sistema-card { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 15%, transparent); }

    /* ===== INTERFACE INTEIRA COM O TOM DO SISTEMA ===== */
    html[data-sistema] {
      --bg:        color-mix(in srgb, var(--accent)  7%, #020617);
      --surface:   color-mix(in srgb, var(--accent) 13%, #0f172a);
      --surface-2: color-mix(in srgb, var(--accent) 18%, #1e293b);
      --line:      color-mix(in srgb, var(--accent) 30%, #1e293b);
      --line-2:    color-mix(in srgb, var(--accent) 35%, #334155);
      --scroll-track: var(--bg); --scroll-thumb: var(--line-2); --scroll-thumb-hover: var(--accent);
    }
    html[data-sistema] .bg-slate-950 { background-color: var(--bg); }
    html[data-sistema] .bg-slate-900 { background-color: var(--surface); }
    html[data-sistema] .bg-slate-900\/80 { background-color: color-mix(in srgb, var(--surface) 80%, transparent); }
    html[data-sistema] .bg-slate-900\/50 { background-color: color-mix(in srgb, var(--surface) 50%, transparent); }
    html[data-sistema] .bg-slate-800 { background-color: var(--surface-2); }
    html[data-sistema] .bg-slate-800\/60 { background-color: color-mix(in srgb, var(--surface-2) 60%, transparent); }
    html[data-sistema] .bg-slate-800\/40 { background-color: color-mix(in srgb, var(--surface-2) 40%, transparent); }
    html[data-sistema] .hover\:bg-slate-700:hover { background-color: var(--line-2); }
    html[data-sistema] .hover\:bg-slate-800:hover { background-color: var(--surface-2); }
    html[data-sistema] .border-slate-800 { border-color: var(--line); }
    html[data-sistema] .border-slate-700 { border-color: var(--line-2); }
    body, header, footer, section div { transition: background-color .25s, border-color .25s, transform .15s; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 dark:bg-slate-950 dark:text-slate-100 light:bg-slate-50 light:text-slate-950 min-h-screen flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white transition-colors duration-300">

  <!-- NOTIFICAÇÕES TOAST CONTAINER -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2 max-w-xs w-full pointer-events-none"></div>

  <!-- =================================================================== -->
  <!-- BLOCO: TELA DE LOGIN                                                -->
  <!-- =================================================================== -->
  <div id="login-screen" class="fixed inset-0 bg-slate-950 dark:bg-slate-950 light:bg-slate-100 z-50 flex items-center justify-center p-4 transition-colors duration-300">
    <div class="bg-slate-900 dark:bg-slate-900 light:bg-white border border-slate-800 dark:border-slate-800 light:border-slate-200 w-full max-w-md rounded-2xl p-8 shadow-2xl space-y-6">
      <div class="text-center space-y-2">
        <div class="inline-flex p-3 bg-indigo-600/20 text-indigo-400 rounded-xl border border-indigo-500/30">
          <i data-lucide="shield" class="w-8 h-8"></i>
        </div>
        <h1 class="font-bold text-2xl text-slate-100 dark:text-slate-100 light:text-slate-900">RPG Campaign Manager</h1>
        <p class="text-xs text-slate-400 dark:text-slate-400 light:text-slate-500">Gestão Multi-Sistema (D&amp;D, Ordem Paranormal e Tormenta20)</p>
      </div>

      <form onsubmit="realizarLogin(event)" class="space-y-4">
        <div id="login-error" class="hidden text-xs text-red-400 bg-red-950/40 border border-red-800 p-2.5 rounded-lg text-center">
          Por favor, preencha o e-mail e a senha para acessar.
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 dark:text-slate-400 light:text-slate-600 mb-1">E-mail ou Usuário</label>
          <input type="text" id="login-usuario" placeholder="mestre@rpg.com" class="w-full bg-slate-800 dark:bg-slate-800 light:bg-slate-50 border border-slate-700 dark:border-slate-700 light:border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-100 dark:text-slate-100 light:text-slate-900 focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 dark:text-slate-400 light:text-slate-600 mb-1">Senha</label>
          <input type="password" id="login-senha" placeholder="••••••••" class="w-full bg-slate-800 dark:bg-slate-800 light:bg-slate-50 border border-slate-700 dark:border-slate-700 light:border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-100 dark:text-slate-100 light:text-slate-900 focus:outline-none focus:border-indigo-500">
        </div>
        <button type="submit" id="btn-login-submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium text-sm shadow-lg shadow-indigo-600/20 transition flex justify-center items-center space-x-2">
          <span>Entrar no Sistema</span>
        </button>
      </form>
    </div>
  </div>

  <!-- =================================================================== -->
  <!-- BLOCO: BARRA DE NAVEGAÇÃO PRINCIPAL (HEADER)                        -->
  <!-- =================================================================== -->
  <header class="bg-slate-900/80 dark:bg-slate-900/80 light:bg-white/80 backdrop-blur-md border-b border-slate-800 dark:border-slate-800 light:border-slate-200 sticky top-0 z-40 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
      <div class="flex items-center space-x-3 shrink-0">
        <div class="p-2 bg-indigo-600/20 text-indigo-400 rounded-lg border border-indigo-500/30">
          <i data-lucide="shield"></i>
        </div>
        <div>
          <h1 class="font-bold text-base sm:text-lg text-slate-100 dark:text-slate-100 light:text-slate-900 leading-tight">RPG Campaign Manager</h1>
          <p id="header-sub" class="text-xs text-slate-400 dark:text-slate-400 light:text-slate-500">Ordem Paranormal</p>
        </div>
      </div>

      <nav class="flex space-x-1 sm:space-x-1.5 overflow-x-auto">
        <button onclick="openModalCampanha()" id="btn-nova-campanha" class="btn-campanha px-2.5 py-2 text-xs sm:text-sm font-medium rounded-md flex items-center space-x-1.5 transition shrink-0">
          <i data-lucide="flag" class="w-4 h-4"></i>
          <span class="hidden md:inline">Nova Campanha</span>
        </button>
        <button onclick="switchTab('personagens')" id="tab-btn-personagens" class="px-2.5 py-2 text-xs sm:text-sm font-medium rounded-md flex items-center space-x-1.5 transition bg-indigo-600 text-white shrink-0">
          <i data-lucide="users" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Personagens</span>
          <span id="badge-count-personagens" class="text-[10px] px-1.5 py-0.2 rounded-full bg-black/25 font-bold">0</span>
        </button>
        <button onclick="switchTab('criaturas')" id="tab-btn-criaturas" class="px-2.5 py-2 text-xs sm:text-sm font-medium rounded-md flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 hover:bg-slate-800 shrink-0">
          <i data-lucide="skull" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Criaturas</span>
          <span id="badge-count-criaturas" class="text-[10px] px-1.5 py-0.2 rounded-full bg-slate-800 text-slate-300 font-bold">0</span>
        </button>
        <button onclick="switchTab('faccoes')" id="tab-btn-faccoes" class="px-2.5 py-2 text-xs sm:text-sm font-medium rounded-md flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 hover:bg-slate-800 shrink-0">
          <i data-lucide="swords" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Facções</span>
          <span id="badge-count-faccoes" class="text-[10px] px-1.5 py-0.2 rounded-full bg-slate-800 text-slate-300 font-bold">0</span>
        </button>
        <button onclick="switchTab('eventos')" id="tab-btn-eventos" class="px-2.5 py-2 text-xs sm:text-sm font-medium rounded-md flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 hover:bg-slate-800 shrink-0">
          <i data-lucide="scroll" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Eventos</span>
          <span id="badge-count-eventos" class="text-[10px] px-1.5 py-0.2 rounded-full bg-slate-800 text-slate-300 font-bold">0</span>
        </button>
        <button onclick="switchTab('mestre')" id="tab-btn-mestre" class="px-2.5 py-2 text-xs sm:text-sm font-medium rounded-md flex items-center space-x-1.5 transition text-slate-400 hover:text-slate-200 hover:bg-slate-800 shrink-0">
          <i data-lucide="crown" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Mestre</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- =================================================================== -->
  <!-- BLOCO: CONTEÚDO PRINCIPAL                                           -->
  <!-- =================================================================== -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Barra de Sistema & Campanha Ativa -->
    <div class="mb-6 bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-lg">
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
          <i data-lucide="layers" class="w-4 h-4 text-indigo-400"></i>
          <label for="sistema-select" class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Sistema:</label>
          <select id="sistema-select" onchange="trocarSistema(this.value)" class="bg-slate-800 border border-slate-700 text-slate-100 rounded-lg px-3 py-1.5 text-sm font-semibold focus:outline-none focus:border-indigo-500">
            <option value="dnd">D&amp;D 5e</option>
            <option value="ordem_paranormal">Ordem Paranormal</option>
            <option value="tormenta20">Tormenta20</option>
          </select>
        </div>

        <span class="text-slate-700 hidden sm:inline">|</span>

        <div class="flex items-center gap-2 flex-wrap">
          <i data-lucide="book-open" class="w-4 h-4 text-indigo-400"></i>
          <label for="campanha-select" class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Campanha:</label>
          <select id="campanha-select" onchange="selecionarCampanha(this.value)" class="bg-slate-800 border border-slate-700 text-slate-100 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500 max-w-xs sm:max-w-sm"></select>
          <button id="btn-edit-campanha" onclick="openModalCampanha(true)" title="Editar campanha ativa" class="hidden text-slate-400 hover:text-indigo-400 p-1.5 rounded bg-slate-800/60 hover:bg-slate-800 transition"><i data-lucide="pencil" class="w-4 h-4"></i></button>
          <button id="btn-del-campanha" onclick="deletarCampanha()" title="Excluir campanha ativa" class="hidden text-slate-500 hover:text-red-400 p-1.5 rounded bg-slate-800/60 hover:bg-slate-800 transition"><i data-lucide="trash" class="w-4 h-4"></i></button>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span id="campanha-count-pill" class="px-2.5 py-1 bg-slate-800 border border-slate-700 text-slate-300 rounded-full text-[11px] font-medium"></span>
        <span id="campanha-badge" class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 rounded-full text-xs font-semibold"></span>
      </div>
      <p id="campanha-desc" class="w-full text-xs text-slate-400 hidden border-t border-slate-800/80 pt-2"></p>
    </div>

    <!-- ================================================================= -->
    <!-- ABA: PERSONAGENS                                                  -->
    <!-- ================================================================= -->
    <section id="view-personagens" class="space-y-6">
      <div class="flex flex-wrap justify-between items-center gap-4">
        <div>
          <h2 id="titulo-personagens" class="text-xl font-bold text-slate-100 dark:text-slate-100 light:text-slate-900">Personagens</h2>
          <p id="subtitulo-personagens" class="text-sm text-slate-400 dark:text-slate-400 light:text-slate-600">Fichas técnicas isoladas por sistema e campanha.</p>
        </div>
        <button onclick="openModalPersonagem()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium text-sm flex items-center space-x-2 shadow-lg shadow-indigo-600/20 transition">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>Novo Personagem</span>
        </button>
      </div>
      <div id="grid-personagens" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </section>

    <!-- ================================================================= -->
    <!-- ABA: CRIATURAS & BESTIÁRIO                                        -->
    <!-- ================================================================= -->
    <section id="view-criaturas" class="space-y-6 hidden">
      <div class="flex flex-wrap justify-between items-center gap-4">
        <div>
          <h2 id="titulo-criaturas" class="text-xl font-bold text-slate-100 dark:text-slate-100 light:text-slate-900">Bestiário &amp; Criaturas</h2>
          <p id="subtitulo-criaturas" class="text-sm text-slate-400 dark:text-slate-400 light:text-slate-600">Gerencie criaturas personalizadas e consulte bases externas compatíveis com o sistema ativo.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="btn-consultar-api" onclick="consultarCriaturasExternas()" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 rounded-lg font-medium text-sm flex items-center space-x-2 transition">
            <i data-lucide="globe" class="w-4 h-4 text-indigo-400"></i>
            <span id="btn-consultar-api-label">Consultar SRD (Open5e)</span>
          </button>
          <button onclick="openModalCriatura()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium text-sm flex items-center space-x-2 shadow-lg shadow-indigo-600/20 transition">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Nova Criatura</span>
          </button>
        </div>
      </div>

      <!-- Status da Consulta Externa / Aviso de Fonte -->
      <div id="api-status-banner" class="hidden rounded-xl p-3.5 text-xs flex items-center justify-between gap-3 border"></div>

      <!-- Barra de Pesquisa e Filtros -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="relative sm:col-span-2">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
          <input type="text" id="filtro-criatura-busca" oninput="renderCriaturas()" placeholder="Pesquisar criatura por nome, tipo ou habilidades..." class="w-full bg-slate-800 border border-slate-700 rounded-lg pl-9 pr-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <select id="filtro-criatura-tipo" onchange="renderCriaturas()" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
            <option value="">Todos os Tipos / Elementos</option>
          </select>
        </div>
        <div class="flex gap-2">
          <select id="filtro-criatura-origem" onchange="renderCriaturas()" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
            <option value="">Todas as Origens</option>
            <option value="personalizada">Personalizadas (Local)</option>
            <option value="externa">API Externa (SRD)</option>
          </select>
          <button onclick="limparFiltrosCriaturas()" title="Limpar filtros" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 rounded-lg text-xs transition shrink-0">
            Limpar
          </button>
        </div>
      </div>

      <!-- Grid de Criaturas -->
      <div id="grid-criaturas" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </section>

    <!-- ================================================================= -->
    <!-- ABA: FACÇÕES                                                      -->
    <!-- ================================================================= -->
    <section id="view-faccoes" class="space-y-6 hidden">
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-xl font-bold text-slate-100 dark:text-slate-100 light:text-slate-900">Facções e Organizações</h2>
          <p class="text-sm text-slate-400 dark:text-slate-400 light:text-slate-600">Controle o nível de reputação, diplomacia e prestígio neste contexto.</p>
        </div>
        <button onclick="openModalFaccao()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium text-sm flex items-center space-x-2 shadow-lg shadow-indigo-600/20 transition">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Nova Facção</span>
        </button>
      </div>
      <div id="grid-faccoes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </section>

    <!-- ================================================================= -->
    <!-- ABA: EVENTOS & ROLADOR DE DADOS                                   -->
    <!-- ================================================================= -->
    <section id="view-eventos" class="space-y-6 hidden">
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-xl font-bold text-slate-100 dark:text-slate-100 light:text-slate-900">Mesa de Dados &amp; Eventos</h2>
          <p class="text-sm text-slate-400 dark:text-slate-400 light:text-slate-600">Role dados online e registre os acontecimentos da campanha atual.</p>
        </div>
        <button onclick="openModalEvento()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium text-sm flex items-center space-x-2 shadow-lg shadow-indigo-600/20 transition">
          <i data-lucide="calendar-plus" class="w-4 h-4"></i>
          <span>Anotar Manualmente</span>
        </button>
      </div>

      <!-- Rolador de Dados -->
      <div class="bg-slate-900 dark:bg-slate-900 light:bg-white border border-slate-800 dark:border-slate-800 light:border-slate-200 rounded-xl p-5 shadow-lg">
        <h3 class="font-bold text-slate-100 dark:text-slate-100 light:text-slate-900 flex items-center gap-2 mb-4"><i data-lucide="dices" class="w-5 h-5 text-indigo-400"></i> Rolador de Dados Online</h3>
        <div class="flex flex-wrap gap-4 items-end">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Quantidade</label>
            <input type="number" id="dice-qtd" value="1" min="1" class="w-24 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Tipo de Dado</label>
            <select id="dice-tipo" class="w-32 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
              <option value="4">d4</option>
              <option value="6">d6</option>
              <option value="8">d8</option>
              <option value="10">d10</option>
              <option value="12">d12</option>
              <option value="20" selected>d20</option>
              <option value="100">d100</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Modificador (+/-)</label>
            <input type="number" id="dice-mod" value="0" class="w-28 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
          </div>
